SE","SP","TO"],"parlamentares":81,"registrados":0},{"id":"c83018","casa":"camara","inicio":"2026-10-29T08:00:00-03:00","fim":null,"tipo":"Reunião Técnica","categoria":"comissao","titulo":"IV Colóquio Franco-Brasileiro de Direito Constitucional A Câmara dos Deputados promoverá o IV Colóquio Franco-Brasileiro de Direito Constitucional, que reunirá conferencistas para debater os desafios e consensos que moldarão o futuro do Direito Constitucional. De caráter acadêmico, o evento reunirá professores, juristas, diplomatas, consultores legislativos e especialistas brasileiros e franceses para o debate de temas relacionados ao Direito Constitucional, ao constitucionalismo comparado, ao controle de constitucionalidade, à justiça constitucional e às relações entre Brasil e França. O evento será transmitido pelo canal da Câmara no YouTube, e os inscritos terão direito a certificado de participação.","orgao":{"id":"100950","sigla":"EVENTOS","nome":"Eventos"},"local":"Anexo II, Plenário 01","situacao":"Convocada","situacaoFonte":"Convocada","reservada":null,"url":"https://www.camara.leg.br/evento-legislativo/83018","pauta":null,"registro":null,"fonte":"https://dadosabertos.camara.leg.br/api/v2/eventos/83018","partidos":[],"ufs":[],"parlamentares":0,"registrados":0}]